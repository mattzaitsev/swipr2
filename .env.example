# Copy to .env to override. Everything has a working default; with no .env the stack runs fully local at zero cost.
# The app container reads this file too (docker-compose.yml), but always uses its own container hostnames.

# ── Outbound proxy (off by default) ─────────────────────────────────────────────
# Only sources listed in PROXY_SOURCES use it; the mock never does. Empty PROXY_URL = direct.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# Provider-specific. Placeholders: {user} {session} {ttl} {country} {region} {city}. [Bracketed] parts are dropped
# when a placeholder inside is empty, so rotating and sticky requests share one template. Illustrative example:
#   PROXY_USERNAME_TEMPLATE={user}-country-{country}[-region-{region}][-session-{session}-sesstime-{ttl}]
PROXY_USERNAME_TEMPLATE={user}
PROXY_SOURCES=facebook
# Proxied bandwidth is metered in Redis; the gateway does not impose a daily spending cap.

# ── Request strategies (src/gateway/strategy.ts). Defaults = baseline behavior ──
# Strategy per source; '*' is the fallback. Built in: default (no-op), retry-proxy-once.
REQUEST_STRATEGY=
# sticky = one exit IP per flow (search + its pages); rotating = new exit IP per request.
SESSION_MODE=sticky
# Provider-side lifetime of a sticky session, minutes ({ttl} in the username template).
PROXY_STICKY_TTL_MIN=10
# Baseline User-Agent, or empty for the HTTP client default. Strategies may override it per request.
USER_AGENT=
ACCEPT_LANGUAGE=
# Extra random delay range a strategy may add before each request, "min-max" ms.
REQUEST_JITTER_MS=0-0
# Base delay available to retry strategies. Each strategy decides whether and how often to retry.
RETRY_BASE_DELAY_MS=1000
# log = print every gateway event (labelled baseline/strategy); off = count only.
GATEWAY_EVENTS=off

# ── Ingest ──────────────────────────────────────────────────────────────────────
INGEST_CONCURRENCY=2
# Queries and areas live in search.config.json (or point SEARCH_CONFIG at another file).

# ── Mock marketplace (local, zero cost) ─────────────────────────────────────────
MOCK_NEW_EVERY_MS=20000
MOCK_REFRESH_EVERY_MS=180000
MOCK_TICK_MS=8000
MOCK_IMAGE_TTL_MIN=60
# Fraction of mock responses that are "Rate limit exceeded" inside an HTTP 200. 0 = off.
MOCK_FAIL_RATE=0
# Set to anything other than mock-search-v1 to simulate a rotated doc_id (jobs fail with SourceChanged).
# MOCK_ACCEPT_DOC_ID=mock-search-v2

# ── Host-only (`npm run dev` outside Docker); the app container ignores these ──
DATABASE_URL=postgres://swipr:swipr@localhost:5433/swipr
REDIS_URL=redis://localhost:6379
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=swipr-dev-key
API_PORT=4200
